# J_AI configuration. Copy to .env and adjust. Never commit .env itself.

# Provider: ollama (local, default) or gpt (OpenAI)
JAI_PROVIDER=ollama

# Ollama settings. llama3 (8B) runs anywhere. Bake-off 2026-09-10 (see README):
# qwen3.8:27b (17GB, needs Ollama 0.32+) is the best judge, slow on a 16GB card;
# gpt-oss:20b (13GB) is the fast judge; qwen2.5:14b grades inconsistently.
JAI_OLLAMA_MODEL=llama3
JAI_OLLAMA_BASE_URL=http://localhost:11434
# Raise the timeout for models that spill past VRAM (qwen3.8:27b on a 16GB card
# grades in 50 to 100s and a model swap adds a load; 120 was too tight).
JAI_OLLAMA_TIMEOUT=600
JAI_JSON_RETRIES=2
JAI_TEMPERATURE=0.2
JAI_MAX_TOKENS=512

# Roles (optional): run the judge and the student agent on different models.
# Unset means JAI_OLLAMA_MODEL for both.
# JAI_JUDGE_MODEL=gpt-oss:20b
# JAI_STUDENT_MODEL=qwen3.8:27b

# Thinking (optional). Only send for models that support it.
# qwen3 family: true / false. gpt-oss: low / medium / high.
# JAI_THINK=low
# JAI_JUDGE_THINK=low
# JAI_STUDENT_THINK=low

# Schema-enforced verdicts are the default (Ollama 'format'). Set 0 for the
# older prompt-only JSON path with retry and rescue.
# JAI_STRUCTURED=1

# Rubric penalties (must_avoid items) shown to the judge: opt-in, see README.
# JAI_RUBRIC_PENALTIES=1

# GPT settings (only if JAI_PROVIDER=gpt)
# OPENAI_API_KEY=your_key_here
# JAI_GPT_MODEL=gpt-4.1-mini

# Modes: chat (default) or eval
# JAI_MODE=eval
# JAI_EVAL_ANSWERS=answers.json
