# J_AI configuration. Copy to .env and adjust. Never commit .env itself.

# Provider: ollama (local, default) or gpt (OpenAI)
JAI_PROVIDER=ollama

# Ollama settings. llama3 (8B) runs anywhere; qwen2.5:14b grades noticeably
# better if you have ~10GB+ of VRAM (selected by calibration testing, 2026-09-05).
JAI_OLLAMA_MODEL=llama3
JAI_OLLAMA_BASE_URL=http://localhost:11434
JAI_OLLAMA_TIMEOUT=120
JAI_JSON_RETRIES=2
JAI_TEMPERATURE=0.2
JAI_MAX_TOKENS=512

# GPT settings (only if JAI_PROVIDER=gpt)
# OPENAI_API_KEY=your_key_here
# JAI_GPT_MODEL=gpt-4.1-mini

# Modes: chat (default) or eval
# JAI_MODE=eval
# JAI_EVAL_ANSWERS=answers.json
